---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MetodoPanel from "../../components/MetodoPanel";

export async function getStaticPaths() {
  const metodos = await getCollection("metodos");
  return metodos.map((m) => {
    const slug = m.id.replace(/^metodos\//, "").replace(/\.md$/, "");
    return {
      params: { slug },
      props: { metodo: m },
    };
  });
}

const { metodo } = Astro.props as { metodo: any };
const { titulo, parametros, tipo_grafico } = metodo.data;
const rawBody: string = metodo.body || "";

const codeMatch = rawBody.match(/```python\n([\s\S]*?)```/);
const codigo = codeMatch ? codeMatch[1].trim() : "";

const htmlContent = metodo.rendered?.html || "";
---

<BaseLayout>
  <div class="max-w-7xl mx-auto p-6 md:p-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="flex-1 min-w-0 lg:w-[60%]">
        <h1 class="text-2xl font-bold tracking-tight mb-6">{titulo}</h1>

        <div class="prose prose-neutral max-w-none leading-relaxed
          prose-headings:text-foreground
          prose-p:text-foreground/85 prose-p:leading-7 prose-p:mb-5
          prose-li:text-foreground/85 prose-li:leading-7
          prose-a:text-accent
          prose-code:font-mono prose-code:text-sm prose-code:bg-muted prose-code:px-1 prose-code:py-0.5 prose-code:rounded
          prose-pre:bg-muted prose-pre:border prose-pre:border-border"
        >
          <Fragment set:html={htmlContent} />
        </div>

        {codigo && (
          <div class="mt-8">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-medium text-muted-foreground">Codigo Python</h3>
              <button
                id="copy-btn"
                class="text-xs text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
              >
                Copiar
              </button>
            </div>
            <pre
              id="code-block"
              class="bg-muted border border-border rounded-lg p-4 overflow-x-auto text-sm font-mono leading-relaxed"
            ><code>{codigo}</code></pre>
          </div>
        )}
      </div>

      <div class="lg:w-[40%] shrink-0">
        <div class="lg:sticky lg:top-8">
          <MetodoPanel
            codigo={codigo}
            parametros={JSON.parse(JSON.stringify(parametros))}
            tipoGrafico={tipo_grafico}
            client:load
          />
        </div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById("copy-btn")?.addEventListener("click", () => {
      const code = document.getElementById("code-block")?.textContent;
      if (code) {
        navigator.clipboard.writeText(code).then(() => {
          const btn = document.getElementById("copy-btn");
          if (btn) {
            btn.textContent = "Copiado!";
            setTimeout(() => { if (btn) btn.textContent = "Copiar"; }, 1500);
          }
        });
      }
    });
  </script>
</BaseLayout>
